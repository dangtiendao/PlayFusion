# ==============================================================================
# PLAYFUSION RLS TEST SUITE ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép file này thành file `.env.rls.local` tại thư mục gốc của project.
# 2. Điền thông tin kết nối từ Supabase Dashboard của dự án DEV (Settings > API).
# 3. Chạy lệnh `npm run test:rls`.
#
# ⚠️ CẢNH BÁO BẢO MẬT:
# - File `.env.rls.local` đã được thêm vào .gitignore, TUYỆT ĐỐI KHÔNG commit.
# - TUYỆT ĐỐI KHÔNG điền key của môi trường PRODUCTION vì test sẽ tạo/xóa dữ liệu thật.
# ==============================================================================

# URL của project Supabase DEV (ví dụ: https://xyzcompany.supabase.co)
VITE_DEV_SUPABASE_URL=https://your-dev-project-ref.supabase.co

# Anon Public Key của project Supabase DEV
VITE_DEV_SUPABASE_ANON_KEY=your-dev-anon-public-key

# Service Role Secret Key của project Supabase DEV (dùng cho setup/teardown test users)
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-secret-key
