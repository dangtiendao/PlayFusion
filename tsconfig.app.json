{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@engines": ["packages/engines/index.ts"],
      "@engines/*": ["packages/engines/*"],
      "@rating": ["packages/rating/index.ts"],
      "@rating/*": ["packages/rating/*"]
    }
  },
  "include": ["src"]
}
