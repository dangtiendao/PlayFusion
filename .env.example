# ==============================================================================
# PLAYFUSION - BIẾN MÔI TRƯỜNG CLIENT (SUPABASE)
# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH CỤC BỘ (LOCAL DEV):
# 1. Sao chép file này thành .env.local:
#    cp .env.example .env.local
# 2. Lấy thông tin từ Supabase Dashboard của project "webgamehub-dev":
#    Settings -> API (Project Settings -> API Keys)
# 3. Điền Project URL vào VITE_SUPABASE_URL và anon key vào VITE_SUPABASE_ANON_KEY.
# 4. TUYỆT ĐỐI KHÔNG commit file .env.local hoặc bất kỳ secret nào lên Git!
# ==============================================================================

# Supabase Project URL (ví dụ: https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anon/Public Key (bắt đầu bằng eyJhbGciOi...)
VITE_SUPABASE_ANON_KEY=
